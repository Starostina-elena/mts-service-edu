{
  "info": {
    "name": "MTS Service - User",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Коллекция для тестирования пользовательских endpoint'ов (создание пользователя). Переменная {{baseUrl}} по умолчанию http://localhost:8080."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "mockUser", "value": "mock@local", "type": "string" },
    { "key": "authUser", "value": "user", "type": "string" },
    { "key": "authPass", "value": "userpass", "type": "string" }
  ],
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{authUser}}", "type": "string" },
      { "key": "password", "value": "{{authPass}}", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "(() => {",
          "  try {",
          "    const auth = pm.request && pm.request.auth;",
          "    if (auth && auth.type === 'noauth') return;",
          "    const user = pm.collectionVariables.get('authUser') || pm.variables.get('authUser') || pm.environment.get('authUser');",
          "    const pass = pm.collectionVariables.get('authPass') || pm.variables.get('authPass') || pm.environment.get('authPass');",
          "    if (!user || !pass) return;",
          "    const val = 'Basic ' + btoa(user + ':' + pass);",
          "    pm.request.headers.upsert({ key: 'Authorization', value: val });",
          "  } catch (e) { console.log('auth helper error', e); }",
          "})();"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Create User",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alice@example.com\",\n  \"name\": \"Alice\",\n  \"password\": \"secret123\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api","users"] }
      },
      "response": [
        {
          "name": "201 Created - success",
          "originalRequest": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/users" }
          },
          "status": "Created",
          "code": 201,
          "_postman_previewlanguage": "json",
          "header": [ { "key": "Content-Type", "value": "application/json" } ],
          "body": "{\n  \"id\": 123,\n  \"email\": \"alice@example.com\",\n  \"name\": \"Alice\",\n  \"role\": \"USER\",\n  \"createdAt\": \"2026-03-11T00:00:00\"\n}"
        },
        {
          "name": "422 Validation error",
          "originalRequest": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/users" }
          },
          "status": "Unprocessable Entity",
          "code": 422,
          "_postman_previewlanguage": "json",
          "header": [ { "key": "Content-Type", "value": "application/json" } ],
          "body": "{\n  \"status\": 422,\n  \"message\": \"validation failed\",\n  \"errors\": { \"email\": \"must be a well-formed email address\" },\n  \"timestamp\": \"2026-03-11T00:00:00Z\"\n}"
        }
      ]
    }
  ]
}
