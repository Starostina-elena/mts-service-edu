{
  "info": {
    "name": "MTS Catalog API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Справочники",
      "item": [
        {
          "name": "Города",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/catalog/cities",
              "host": ["{{baseUrl}}"],
              "path": ["catalog", "cities"]
            }
          }
        },
        {
          "name": "Сервисы",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/catalog/services",
              "host": ["{{baseUrl}}"],
              "path": ["catalog", "services"]
            }
          }
        }
      ]
    },
    {
      "name": "Каталог",
      "item": [
        {
          "name": "Домашний интернет (cityId=1)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/catalog/home?cityId=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["catalog", "home"],
              "query": [
                { "key": "cityId", "value": "1" },
                { "key": "priceMax", "value": "1000", "disabled": true },
                { "key": "after", "value": "5", "disabled": true },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Мобильная связь",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/catalog/mobile?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["catalog", "mobile"],
              "query": [
                { "key": "internetGb", "value": "10", "disabled": true },
                { "key": "callsMinutes", "value": "300", "disabled": true },
                { "key": "forFamily", "value": "true", "disabled": true },
                { "key": "noSubscriptionFee", "value": "true", "disabled": true },
                { "key": "after", "value": "5", "disabled": true },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Устройства",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/catalog/devices?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["catalog", "devices"],
              "query": [
                { "key": "after", "value": "5", "disabled": true },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Стационарный телефон (cityId=1)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/catalog/landline?cityId=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["catalog", "landline"],
              "query": [
                { "key": "cityId", "value": "1" },
                { "key": "after", "value": "5", "disabled": true },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Спутниковое ТВ (cityId=1)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/catalog/satellite-tv?cityId=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["catalog", "satellite-tv"],
              "query": [
                { "key": "cityId", "value": "1" },
                { "key": "after", "value": "5", "disabled": true },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Для бизнеса",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/catalog/business?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["catalog", "business"],
              "query": [
                { "key": "after", "value": "5", "disabled": true },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Детали тарифа",
      "item": [
        {
          "name": "Тариф по ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/catalog/tariffs/1",
              "host": ["{{baseUrl}}"],
              "path": ["catalog", "tariffs", "1"]
            }
          }
        }
      ]
    }
  ]
}