{
  "info": {
    "name": "MTS Service — RBAC Authorization Tests",
    "description": "Тесты авторизации для JAAS + HTTP Basic аутентификации с ролями USER, MANAGER, ADMIN.\n\nТестовые пользователи (пароль для всех: password):\n- user@test.com (USER)\n- manager@test.com (MANAGER)\n- admin@test.com (ADMIN)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "userEmail", "value": "user@test.com" },
    { "key": "userPassword", "value": "password" },
    { "key": "managerEmail", "value": "manager@test.com" },
    { "key": "managerPassword", "value": "password" },
    { "key": "adminEmail", "value": "admin@test.com" },
    { "key": "adminPassword", "value": "password" }
  ],
  "item": [
    {
      "name": "1. Регистрация (публичный эндпоинт)",
      "item": [
        {
          "name": "Регистрация нового пользователя (без авторизации) → 201",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser_{{$timestamp}}@test.com\",\n  \"name\": \"Test User\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Роль — USER', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.role).to.eql('USER');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Регистрация дубликата email → 409",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@test.com\",\n  \"name\": \"Duplicate\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Аутентификация",
      "item": [
        {
          "name": "Без credentials → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/catalog/mobile", "host": ["{{baseUrl}}"], "path": ["catalog", "mobile"] },
            "auth": { "type": "noauth" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Неверный пароль → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/catalog/mobile", "host": ["{{baseUrl}}"], "path": ["catalog", "mobile"] },
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "user@test.com" },
                { "key": "password", "value": "wrongpassword" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Несуществующий пользователь → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/catalog/mobile", "host": ["{{baseUrl}}"], "path": ["catalog", "mobile"] },
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "nonexistent@test.com" },
                { "key": "password", "value": "password" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Верные credentials (USER) → 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/catalog/mobile", "host": ["{{baseUrl}}"], "path": ["catalog", "mobile"] },
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{userEmail}}" },
                { "key": "password", "value": "{{userPassword}}" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
