{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "MTS Applications",
		"description": "Заявки на подключение — эндпоинты /applications",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "authUser",
			"value": "manager",
			"type": "string"
		},
		{
			"key": "authPass",
			"value": "managerpass",
			"type": "string"
		},
		{
			"key": "userId",
			"value": "1",
			"type": "string"
		},
		{
			"key": "applicationId",
			"value": "1",
			"type": "string"
		},
		{
			"key": "applicationId2",
			"value": "2",
			"type": "string"
		},
		{
			"key": "tariffId",
			"value": "1",
			"type": "string"
		}
	],
	"auth": {
		"type": "basic",
		"basic": [
			{
				"key": "username",
				"value": "{{authUser}}",
				"type": "string"
			},
			{
				"key": "password",
				"value": "{{authPass}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Подать заявку на подключение",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "X-User-Id",
						"value": "{{userId}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"tariffId\": {{tariffId}},\n  \"address\": \"г. Москва, ул. Примерная, д. 1, кв. 10\",\n  \"additionalServiceIds\": []\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/applications",
					"host": ["{{baseUrl}}"],
					"path": ["applications"]
				},
				"description": "Создать заявку на подключение тарифа. Возвращает 201."
			},
			"response": []
		},
		{
			"name": "Список заявок (без фильтра)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/applications?limit=20",
					"host": ["{{baseUrl}}"],
					"path": ["applications"],
					"query": [
						{
							"key": "status",
							"value": "pending",
							"disabled": true
						},
						{
							"key": "after",
							"value": "",
							"disabled": true
						},
						{
							"key": "limit",
							"value": "20"
						}
					]
				},
				"description": "Список всех заявок (Менеджер / Администратор). Фильтр по status: pending, approved, rejected, connected."
			},
			"response": []
		},
		{
			"name": "Список заявок (status=pending)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/applications?status=PENDING&limit=20",
					"host": ["{{baseUrl}}"],
					"path": ["applications"],
					"query": [
						{
							"key": "status",
							"value": "PENDING"
						},
						{
							"key": "after",
							"value": "",
							"disabled": true
						},
						{
							"key": "limit",
							"value": "20"
						}
					]
				},
				"description": "Список заявок со статусом PENDING."
			},
			"response": []
		},
		{
			"name": "Детали заявки",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/applications/{{applicationId}}",
					"host": ["{{baseUrl}}"],
					"path": ["applications", "{{applicationId}}"]
				},
				"description": "Подробная информация о заявке: доп. услуги, паспорт, техническая возможность."
			},
			"response": []
		},
		{
			"name": "Одобрить заявку",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "X-Mock-User",
						"value": "manager@local",
						"description": "(deprecated) mock header",
						"disabled": true
					}
				],
				"url": {
					"raw": "{{baseUrl}}/applications/{{applicationId}}/approve",
					"host": ["{{baseUrl}}"],
					"path": ["applications", "{{applicationId}}", "approve"]
				},
				"description": "Одобрить заявку (Менеджер). 409 — если заявка уже обработана."
			},
			"response": []
		},
		{
			"name": "Отклонить заявку",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "X-Mock-User",
						"value": "manager@local",
						"description": "(deprecated) mock header",
						"disabled": true
					},
					{
						"key": "X-User-Id",
						"value": "{{userId}}",
						"description": "ID менеджера/админа"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"reason\": \"Технически невозможно подключение по данному адресу\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/applications/{{applicationId2}}/reject",
					"host": ["{{baseUrl}}"],
					"path": ["applications", "{{applicationId2}}", "reject"]
				},
				"description": "Отклонить заявку с указанием причины (Администратор)."
			},
			"response": []
		}
	]
}
