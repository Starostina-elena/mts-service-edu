{
  "info": {
    "name": "MTS Service - Admin (tariffs & services)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Коллекция для тестирования admin endpoints: create tariff, archive tariff, create service. Используйте {{baseUrl}} и заголовок X-Mock-User (admin@local)."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "adminUser", "value": "admin@local", "type": "string" },
    { "key": "exampleTariffId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Create tariff (home)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Mock-User", "value": "{{adminUser}}", "description": "must be admin@local" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Home Super 200\",\n  \"category\": \"home\",\n  \"price\": 999.99,\n  \"description\": \"Home package: internet + TV\",\n  \"speed_mbps\": 200,\n  \"tv_channels\": 120,\n  \"service_ids\": [],\n  \"city_prices\": [ { \"city_id\": \"MSK\", \"price\": 1099.99 } ]\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/admin/tariffs", "host": ["{{baseUrl}}"], "path": ["admin","tariffs"] }
      },
      "response": []
    },
    {
      "name": "Archive tariff",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "X-Mock-User", "value": "{{adminUser}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin/tariffs/{{exampleTariffId}}/archive",
          "host": ["{{baseUrl}}"],
          "path": ["admin","tariffs","{{exampleTariffId}}","archive"],
          "variable": [ { "key": "exampleTariffId", "value": "1" } ]
        }
      },
      "response": []
    },
    {
      "name": "Create additional service",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Mock-User", "value": "{{adminUser}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Static IP\",\n  \"price\": 99.99,\n  \"description\": \"Dedicated static IPv4 address\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/admin/services", "host": ["{{baseUrl}}"], "path": ["admin","services"] }
      },
      "response": []
    }
  ]
}

