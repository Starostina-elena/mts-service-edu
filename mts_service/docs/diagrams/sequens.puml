@startuml
title Полный процесс заказа и одобрения тарифа

actor User
actor Manager
participant "Frontend (ЛК)" as UserFrontend
participant "Frontend (Admin)" as AdminFrontend
participant "OrderController" as Controller
participant "AdminController" as AdminController
participant "OrderService" as Service
participant "TariffRepository" as TariffRepo
participant "OrderRepository" as OrderRepo
participant "BillingService" as Billing
participant "AvailabilityService" as Availability
participant "ProvisioningService" as Provisioning
participant "NotificationService" as Notification

== Создание заявки пользователем ==
User -> UserFrontend : Нажимает "Подключить тариф"
UserFrontend -> Controller : POST /api/v1/orders (tariffId, userId, addressId)
Controller -> Service : createOrder(request)

Service -> TariffRepo : findById(tariffId)
TariffRepo --> Service : tariff

Service -> Billing : checkBalance(userId)
Billing --> Service : balance OK

Service -> Availability : checkAvailability(addressId, tariffId)
Availability --> Service : available

Service -> OrderRepo : save(order status=CREATED)
OrderRepo --> Service : orderId

Service -> Notification : sendOrderCreated(orderId)
Notification --> Service : success

Service --> Controller : orderId, status=CREATED
Controller --> UserFrontend : 201 Created
UserFrontend --> User : Показать "Заявка создана"

== Отслеживание статуса заявки ==
User -> UserFrontend : Открывает "Мои заявки"
UserFrontend -> Controller : GET /api/v1/orders/{orderId}
Controller -> Service : getOrder(orderId)
Service -> OrderRepo : findById(orderId)
OrderRepo --> Service : order(status)
Service --> Controller : orderDTO
Controller --> UserFrontend : 200 OK
UserFrontend --> User : Показать статус заявки

== Одобрение заявки менеджером ==
Manager -> AdminFrontend : Нажимает "Одобрить"
AdminFrontend -> AdminController : POST /admin/orders/{orderId}/approve
AdminController -> Service : approveOrder(orderId)

Service -> OrderRepo : findById(orderId)
OrderRepo --> Service : order

Service -> OrderRepo : updateStatus(APPROVED)

Service -> Provisioning : activateService(orderId)
Provisioning --> Service : CONNECTED

Service -> OrderRepo : updateStatus(CONNECTED)

Service -> Notification : notifyUser(CONNECTED)
Notification --> Service : success

Service --> AdminController : success
AdminController --> AdminFrontend : 200 OK
AdminFrontend --> Manager : Показать "Подключено"

@enduml