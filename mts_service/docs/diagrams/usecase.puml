@startuml
left to right direction

actor User
actor Менеджер
actor Админ

rectangle "ИС Каталог и ЛК пользователя" {

  ' -----------------------------
  ' Каталог (действия пользователя)
  ' -----------------------------
  rectangle "Каталог" as Catalog {
    (Просмотреть каталог)
    (Просмотреть тарифы)
    (Просмотреть услуги)
    (Просмотреть технологии)
    (Просмотреть детали тарифа)
    (Настроить тариф)
    (Подать заявку на подключение)
    (Выбрать дополнительные услуги)
  }

  ' -----------------------------
  ' Личный кабинет (отображение состояния)
  ' -----------------------------
  rectangle "Личный кабинет пользователя" as LK {
    (Просмотреть текущий тариф)
    (Просмотреть подключённые услуги)
    (Просмотреть подключённые технологии)
    (Просмотреть стоимость тарифа)
    (Отслеживать статус заявки)
  }

  ' -----------------------------
  ' Менеджерские действия
  ' -----------------------------
  (Проверить баланс)
  (Проверить тех возможность)
  (Одобрить заявку)
  (Отклонить заявку)
  (Подключить услугу)

  ' -----------------------------
  ' Админские действия
  ' -----------------------------
  (Создать тариф)
  (Редактировать тариф)
  (Архивировать тариф)
}

' -----------------------------
' Связи пользователя
' -----------------------------
User -- (Просмотреть каталог)
User -- (Просмотреть тарифы)
User -- (Просмотреть услуги)
User -- (Просмотреть технологии)
User -- (Просмотреть детали тарифа)
User -- (Настроить тариф)
User -- (Подать заявку на подключение)
User -- (Выбрать дополнительные услуги)

User -- (Просмотреть текущий тариф)
User -- (Просмотреть подключённые услуги)
User -- (Просмотреть подключённые технологии)
User -- (Просмотреть стоимость тарифа)
User -- (Отслеживать статус заявки)

' -----------------------------
' Последовательности / зависимости
' -----------------------------
(Просмотреть детали тарифа) .> (Просмотреть тарифы) : <<include>>
(Настроить тариф) .> (Просмотреть тарифы) : <<include>>
(Подать заявку на подключение) .> (Просмотреть детали тарифа) : <<include>>
(Отслеживать статус заявки) ..> (Подать заявку на подключение) : <<extend>>
(Выбрать дополнительные услуги) ..> (Просмотреть текущий тариф) : <<include>>

' -----------------------------
' Менеджерские действия
' -----------------------------
Менеджер -- (Проверить баланс)
Менеджер -- (Проверить тех возможность)
Менеджер -- (Одобрить заявку)
Менеджер -- (Отклонить заявку)
Менеджер -- (Подключить услугу)

(Подать заявку на подключение) ..> (Проверить баланс) : <<extend>>
(Подать заявку на подключение) ..> (Проверить тех возможность) : <<extend>>

Менеджер -- (Просмотреть заявки)
Менеджер -- (Просмотреть заявку подробно)

' -----------------------------
' Админские действия
' -----------------------------
Админ -- (Создать тариф)
Админ -- (Редактировать тариф)
Админ -- (Архивировать тариф)

@enduml