{
  "info": {
    "name": "MTS Service - Account, Balance & Pagination",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Коллекция для тестирования /account, /catalog и /applications endpoints. Используйте переменную {{baseUrl}} (default http://localhost:8080) и заголовок X-Mock-User для мок-аутентификации.\n\nВсе пагинированные ответы имеют формат CursorPage:\n  { \"items\": [...], \"nextCursor\": 42 }\nnextCursor: null означает последнюю страницу."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "mockUser",
      "value": "mock@local",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Get my applications",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "X-Mock-User", "value": "{{mockUser}}", "description": "mock user header (mock@local / manager@local / admin@local)" }
        ],
        "url": {
          "raw": "{{baseUrl}}/account/applications",
          "host": ["{{baseUrl}}"],
          "path": ["account","applications"]
        }
      },
      "response": []
    },
    {
      "name": "Get my balance",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "X-Mock-User", "value": "{{mockUser}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/account/balance",
          "host": ["{{baseUrl}}"],
          "path": ["account","balance"]
        }
      },
      "response": [
        {
          "name": "200 OK – список заявок пользователя",
          "originalRequest": {
            "method": "GET",
            "header": [{ "key": "X-Mock-User", "value": "{{mockUser}}" }],
            "url": { "raw": "{{baseUrl}}/account/applications", "host": ["{{baseUrl}}"], "path": ["account","applications"] }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "[\n  {\n    \"id\": 1,\n    \"tariffId\": 3,\n    \"tariffName\": \"Домашний Старт\",\n    \"status\": \"PENDING\",\n    \"address\": \"ул. Ленина, 5\",\n    \"createdAt\": \"2025-03-01T10:00:00\"\n  }\n]"
        }
      ]
    },
    {
      "name": "Initiate top-up (create payment link)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Mock-User", "value": "{{mockUser}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 500.00,\n  \"return_url\": \"http://localhost:3000/pay-return\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/account/balance/top-up",
          "host": ["{{baseUrl}}"],
          "path": ["account","balance","top-up"]
        }
      },
      "response": [
        {
          "name": "200 OK – payment URL создан",
          "originalRequest": {
            "method": "POST",
            "header": [
              { "key": "X-Mock-User", "value": "{{mockUser}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 500.00\n}" },
            "url": { "raw": "{{baseUrl}}/account/balance/top-up", "host": ["{{baseUrl}}"], "path": ["account","balance","top-up"] }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"paymentUrl\": \"http://payments.example.com/a1b2c3d4-...\"\n}"
        }
      ]
    },
    {
      "name": "--- CATALOG (cursor pagination) ---",
      "item": [
        {
          "name": "GET /catalog/mobile – первая страница",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/catalog/mobile?limit=2",
              "host": ["{{baseUrl}}"],
              "path": ["catalog","mobile"],
              "query": [
                { "key": "limit", "value": "2" },
                { "key": "internetGb", "value": "", "disabled": true },
                { "key": "callsMinutes", "value": "", "disabled": true },
                { "key": "forFamily", "value": "", "disabled": true },
                { "key": "noSubscriptionFee", "value": "", "disabled": true },
                { "key": "after", "value": "", "disabled": true }
              ]
            }
          },
          "response": [
            {
              "name": "200 OK – CursorPage (есть следующая страница)",
              "originalRequest": {
                "method": "GET",
                "url": { "raw": "{{baseUrl}}/catalog/mobile?limit=2", "host": ["{{baseUrl}}"], "path": ["catalog","mobile"], "query": [{ "key": "limit", "value": "2" }] }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"items\": [\n    { \"id\": 1, \"name\": \"Тариф М\", \"internetGb\": 10, \"callsMinutes\": 300, \"basePrice\": 299.00 },\n    { \"id\": 2, \"name\": \"Тариф L\", \"internetGb\": 25, \"callsMinutes\": 600, \"basePrice\": 499.00 }\n  ],\n  \"nextCursor\": 2\n}"
            }
          ]
        },
        {
          "name": "GET /catalog/mobile – следующая страница (after=2)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/catalog/mobile?limit=2&after=2",
              "host": ["{{baseUrl}}"],
              "path": ["catalog","mobile"],
              "query": [
                { "key": "limit", "value": "2" },
                { "key": "after", "value": "2" }
              ]
            }
          },
          "response": [
            {
              "name": "200 OK – CursorPage (последняя страница, nextCursor=null)",
              "originalRequest": {
                "method": "GET",
                "url": { "raw": "{{baseUrl}}/catalog/mobile?limit=2&after=2", "host": ["{{baseUrl}}"], "path": ["catalog","mobile"], "query": [{ "key": "limit", "value": "2" }, { "key": "after", "value": "2" }] }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"items\": [\n    { \"id\": 3, \"name\": \"Тариф XL\", \"internetGb\": 50, \"callsMinutes\": 1000, \"basePrice\": 699.00 }\n  ],\n  \"nextCursor\": null\n}"
            }
          ]
        },
        {
          "name": "GET /catalog/home",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/catalog/home?cityId=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["catalog","home"],
              "query": [
                { "key": "cityId", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "priceMax", "value": "", "disabled": true },
                { "key": "after", "value": "", "disabled": true }
              ]
            }
          },
          "response": [
            {
              "name": "200 OK – CursorPage<TariffHomeCardDto>",
              "originalRequest": {
                "method": "GET",
                "url": { "raw": "{{baseUrl}}/catalog/home?cityId=1&limit=20", "host": ["{{baseUrl}}"], "path": ["catalog","home"], "query": [{ "key": "cityId", "value": "1" }, { "key": "limit", "value": "20" }] }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"items\": [\n    { \"id\": 4, \"name\": \"Домашний Старт\", \"cityPrice\": 500.00, \"speedMbps\": 100 }\n  ],\n  \"nextCursor\": null\n}"
            }
          ]
        },
        {
          "name": "GET /catalog/devices",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/catalog/devices?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["catalog","devices"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "after", "value": "", "disabled": true }
              ]
            }
          },
          "response": [
            {
              "name": "200 OK – CursorPage<TariffDeviceCardDto>",
              "originalRequest": {
                "method": "GET",
                "url": { "raw": "{{baseUrl}}/catalog/devices?limit=20", "host": ["{{baseUrl}}"], "path": ["catalog","devices"], "query": [{ "key": "limit", "value": "20" }] }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"items\": [\n    { \"id\": 7, \"name\": \"Роутер Pro\", \"basePrice\": 3999.00 }\n  ],\n  \"nextCursor\": null\n}"
            }
          ]
        },
        {
          "name": "GET /catalog/landline",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/catalog/landline?cityId=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["catalog","landline"],
              "query": [
                { "key": "cityId", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "after", "value": "", "disabled": true }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /catalog/satellite-tv",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/catalog/satellite-tv?cityId=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["catalog","satellite-tv"],
              "query": [
                { "key": "cityId", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "after", "value": "", "disabled": true }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /catalog/business",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/catalog/business?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["catalog","business"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "after", "value": "", "disabled": true }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "--- APPLICATIONS (cursor pagination) ---",
      "item": [
        {
          "name": "GET /applications – первая страница",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Mock-User", "value": "manager@local", "description": "Используйте manager@local для доступа ко всем заявкам" }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications?limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["applications"],
              "query": [
                { "key": "limit", "value": "5" },
                { "key": "status", "value": "", "disabled": true, "description": "PENDING | APPROVED | REJECTED" },
                { "key": "userId", "value": "", "disabled": true },
                { "key": "after", "value": "", "disabled": true }
              ]
            }
          },
          "response": [
            {
              "name": "200 OK – CursorPage<ApplicationDto>",
              "originalRequest": {
                "method": "GET",
                "header": [{ "key": "X-Mock-User", "value": "manager@local" }],
                "url": { "raw": "{{baseUrl}}/applications?limit=5", "host": ["{{baseUrl}}"], "path": ["applications"], "query": [{ "key": "limit", "value": "5" }] }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"items\": [\n    {\n      \"id\": 1,\n      \"tariffId\": 3,\n      \"tariffName\": \"Домашний Старт\",\n      \"status\": \"PENDING\",\n      \"address\": \"ул. Ленина, 5\",\n      \"createdAt\": \"2025-03-01T10:00:00\"\n    },\n    {\n      \"id\": 2,\n      \"tariffId\": 5,\n      \"tariffName\": \"Мобильный L\",\n      \"status\": \"APPROVED\",\n      \"address\": \"пр. Мира, 12\",\n      \"createdAt\": \"2025-03-02T11:30:00\"\n    }\n  ],\n  \"nextCursor\": 2\n}"
            }
          ]
        },
        {
          "name": "GET /applications – фильтр по статусу PENDING",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Mock-User", "value": "manager@local" }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications?status=PENDING&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["applications"],
              "query": [
                { "key": "status", "value": "PENDING" },
                { "key": "limit", "value": "10" },
                { "key": "after", "value": "", "disabled": true }
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST /applications – создать заявку",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Mock-User", "value": "{{mockUser}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tariffId\": 1,\n  \"address\": \"ул. Тестовая, 1\",\n  \"cityId\": 1,\n  \"additionalServiceIds\": []\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/applications",
              "host": ["{{baseUrl}}"],
              "path": ["applications"]
            }
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "X-Mock-User", "value": "mock@local" }, { "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"tariffId\": 1,\n  \"address\": \"ул. Тестовая, 1\",\n  \"cityId\": 1,\n  \"additionalServiceIds\": []\n}" },
                "url": { "raw": "{{baseUrl}}/applications", "host": ["{{baseUrl}}"], "path": ["applications"] }
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": 3,\n  \"tariffId\": 1,\n  \"tariffName\": \"Мобильный М\",\n  \"status\": \"PENDING\",\n  \"address\": \"ул. Тестовая, 1\",\n  \"createdAt\": \"2025-03-24T12:00:00\"\n}"
            },
            {
              "name": "402 Insufficient Funds",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "X-Mock-User", "value": "mock@local" }, { "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"tariffId\": 1,\n  \"address\": \"ул. Тестовая, 1\",\n  \"cityId\": 1,\n  \"additionalServiceIds\": []\n}" },
                "url": { "raw": "{{baseUrl}}/applications", "host": ["{{baseUrl}}"], "path": ["applications"] }
              },
              "status": "Payment Required",
              "code": 402,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"Insufficient funds\",\n  \"message\": \"Balance is too low to submit this application\"\n}"
            }
          ]
        },
        {
          "name": "POST /applications/{id}/approve",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Mock-User", "value": "manager@local" }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications/1/approve",
              "host": ["{{baseUrl}}"],
              "path": ["applications","1","approve"]
            }
          },
          "response": []
        },
        {
          "name": "POST /applications/{id}/reject",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Mock-User", "value": "manager@local" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Адрес недоступен для подключения\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/applications/1/reject",
              "host": ["{{baseUrl}}"],
              "path": ["applications","1","reject"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}

